{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KaizenLinguistics",
  "version": "0.2.0",
  "identifier": "com.kaizenlinguistics.desktop",
  "build": {
    "frontendDist": "../src-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KAIZEN LINGUISTICS — Atelier Aldus",
        "width": 1360,
        "height": 920,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": [
      "../../packs/*.klpack",
      "../../packs/user_telemetry.db"
    ]
  }
}
